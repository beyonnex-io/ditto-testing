MONGO_DB_HOSTNAME=mongodb
MONGO_DB_PORT=27017
THINGS_SEARCH_UPDATER_STREAM_PERSISTENCE_WITH_ACKS_WRITE_CONCERN=journaled
QUERY_PERSISTENCE_MONGO_DB_READ_CONCERN=local
DITTO_DDATA_SUBSCRIPTION_DELAY=5s
# Use the memory-optimized (tree-based) policy enforcer instead of Ditto's default trie-based one, so the
# system tests exercise TreeBasedPolicyEnforcer and its authorization-verdict memo. This sets the HOCON
# key; the authoritative setting is the matching -D in each service's JAVA_TOOL_OPTIONS in
# docker-compose.yml, which is immune to FeatureToggle's static-init ordering. Keep the two in sync.
DITTO_DEVOPS_FEATURE_POLICY_ENFORCEMENT_USE_THROUGHPUT_OPTIMIZED_EVALUATOR_ENABLED=false
